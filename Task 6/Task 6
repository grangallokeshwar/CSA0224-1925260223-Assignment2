#include <stdio.h>

unsigned long checks;

int prime_original(unsigned long n)
{
    unsigned long i;
    checks = 0;
    if (n < 2) return 0;
    for (i = 2; i * i <= n; i++) {
        checks++;
        if (n % i == 0) return 0;
    }
    return 1;
}

int prime_redesigned(unsigned long n)
{
    unsigned long i;
    checks = 0;
    if (n < 2) return 0;
    if (n == 2) return 1;
    if (n % 2 == 0) { checks++; return 0; }
    for (i = 3; i <= n / i; i += 2) {
        checks++;
        if (n % i == 0) return 0;
    }
    return 1;
}

int main(void)
{
    unsigned long values[] = {97, 100, 7919, 1000003};
    int k;
    puts("Ticket     Original checks     Redesigned checks");
    for (k = 0; k < 4; k++) {
        unsigned long old_count, new_count;
        int old_result = prime_original(values[k]);
        old_count = checks;
        int new_result = prime_redesigned(values[k]);
        new_count = checks;
        printf("%8lu   %8lu (%s)       %8lu (%s)\n", values[k], old_count,
               old_result ? "prime" : "not prime", new_count,
               new_result ? "prime" : "not prime");
    }
    return 0;
}
