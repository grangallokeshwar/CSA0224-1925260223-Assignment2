#include <stdio.h>

int main(void)
{
    double price, qty, gross;
    double discount, taxable, gst, total, net;
    int senior;

    printf("Enter price: ");
    if (scanf("%lf", &price) != 1 || price < 0)
    {
        printf("Invalid price.\n");
        return 1;
    }

    printf("Enter quantity: ");
    if (scanf("%lf", &qty) != 1 || qty < 0)
    {
        printf("Invalid quantity.\n");
        return 1;
    }

    printf("Senior citizen? (1=Yes, 0=No): ");
    if (scanf("%d", &senior) != 1 ||
        (senior != 0 && senior != 1))
    {
        printf("Invalid choice.\n");
        return 1;
    }

    gross = price * qty;
    discount = senior ? gross * 0.15 : 0.0;
    taxable = gross - discount;
    gst = taxable * 0.05;
    total = taxable + gst;
    net = (total > 1000.0) ? total - 50.0 : total;

    printf("\nGross Amount = Rs. %.2f\n", gross);
    printf("Discount = Rs. %.2f\n", discount);
    printf("GST = Rs. %.2f\n", gst);
    printf("Total Amount = Rs. %.2f\n", total);
    printf("Net Amount = Rs. %.2f\n", net);

    return 0;
}

