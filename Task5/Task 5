#include <stdio.h>

unsigned long checks;

int prime_basic_for(unsigned long n)
{
    unsigned long i;
    checks = 0;
    if (n < 2) return 0;
    for (i = 2; i < n; i++) {
        checks++;
        if (n % i == 0) return 0;
    }
    return 1;
}

int prime_sqrt_for(unsigned long n)
{
    unsigned long i;
    checks = 0;
    if (n < 2) return 0;
    for (i = 2; i * i <= n; i++) {
        checks++;
        if (n % i == 0) return 0;
    }
    return 1;
}

int prime_sqrt_while(unsigned long n)
{
    unsigned long i = 2;
    checks = 0;
    if (n < 2) return 0;
    while (i * i <= n) {
        checks++;
        if (n % i == 0) return 0;
        i++;
    }
    return 1;
}

int prime_sqrt_do(unsigned long n)
{
    unsigned long i = 2;
    checks = 0;
    if (n < 2) return 0;
    do {
        if (i * i > n) break;
        checks++;
        if (n % i == 0) return 0;
        i++;
    } while (i * i <= n);
    return 1;
}

int main(void)
{
    unsigned long a[] = {97, 100, 7919, 1000003};
    int k;
    puts("Improved for-loop counts:");
    for (k = 0; k < 4; k++) {
        int p = prime_sqrt_for(a[k]);
        printf("%8lu %-9s divisions = %lu\n", a[k], p ? "prime" : "not prime", checks);
    }
    puts("\nLoop-version check for 97:");
    printf("for: "); prime_sqrt_for(97); printf("%lu\n", checks);
    printf("while: "); prime_sqrt_while(97); printf("%lu\n", checks);
    printf("do-while: "); prime_sqrt_do(97); printf("%lu\n", checks);
    puts("\nBasic for-loop checks for 97:");
    prime_basic_for(97); printf("%lu\n", checks);
    return 0;
}
